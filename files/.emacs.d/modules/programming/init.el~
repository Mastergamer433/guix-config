(setq module-schema '(:enabled))

(defmodule (:enabled)
	   (when (plist-get cfg :enabled)
	     (use-package eglot
	       :hook ((rust-mode . eglot-ensure))
	       :config
	       ;; Optional: Auto-format on save
	       (add-hook 'eglot-managed-mode-hook
			 (lambda ()
			   (add-hook 'before-save-hook
				     #'eglot-format-buffer
				     nil t))))))
