(defwindow bar


  :monitor 0
  :windowtype "dock"
  :exclusive true
  :geometry
    (geometry
      :x "0%"
      :y "0%"
      :width "100%"
      :height "36px"
      :anchor "top center")

  (bar))

(deflisten player
  :initial "No music playing"
  "playerctl -F -f '{{title}}|||{{artist}}' metadata")

(defwidget music []
  (box
    :class "music"
    :orientation "v"
    :halign "center"
    :valign "center"

    (label
      :class "music-title"
      :text {player == "No music playing"
             ? "Nothing playing"
             : strsplit(player, "|||")[0]})

    (label
      :class "music-artist"
      :text {player == "No music playing"
             ? ""
             : strsplit(player, "|||")[1]})))

(deflisten workspaces
  :initial "[]"
  "~/.config/eww/scripts/niri-workspaces")

(defwidget workspace [id idx name focused]
  (button
    :class {focused == "true"
            ? "workspace workspace-active"
            : "workspace"}
    :onclick "niri msg action focus-workspace ${idx}"
    name))

(defwidget workspaces []
  (box
    :class "workspaces"
    :orientation "h"
    :spacing 6

    (for workspace in workspaces
      (workspace
        :id {workspace.id}
        :idx {workspace.idx}
        :name {workspace.name}
        :focused {workspace.focused}))))

(defwidget bar []
  (box
:class "bar-container"
(centerbox
    :class "bar"

    (box
      :halign "start"
      :spacing 12
      (label :class "logo" :text "")
      (workspaces))

    (music)

    (box
      :halign "end"
      :spacing 12))))
